def print_grid(s):
    for i in range(0, 9, 3):
        print(*s[i:i+3])
    print()

def dfs(start, goal):
    q = [(start, [])]
    visited = {start}

    while q:
        state, path = q.pop(0)

        if state == goal:
          for s in path + [state]:
            print_grid(s)
          print("goal reached")
          return

        zero = state.index(0)

        for m in [-3, 3, -1, 1]:
            p = zero + m
            if 0 <= p < 9:
                if m in (-1, 1) and zero // 3 != p // 3:
                    continue

                new = list(state)
                new[zero], new[p] = new[p], new[zero]
                new = tuple(new)

                if new not in visited:
                    visited.add(new)
                    q.append((new, path + [state]))

start = (1, 2, 3, 0, 4, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

dfs(start, goal)
